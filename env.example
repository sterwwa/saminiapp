# Скопируйте в .env (или задайте переменные в панели Lunafy). Токен НИКОГДА не коммитить и не присылать в чат.
BOT_TOKEN=сюда_токен_от_BotFather
CHAT_ID=-1003998580449
TIMEZONE=Europe/Kaliningrad
GROUP_NAME=СА-2/25
# Необязательно:
# SEND_HOUR=20
# CHECK_MINUTES=30
# CHECK_DAYS_AHEAD=3
# DATA_DIR=data
# REMIND_MODE=first      # first | all | off
# REMIND_MINUTES=30
# PIN_DAILY=1
# ADMIN_IDS=123456789   # ваш id из команды /id; если пусто, /status и /raw закрыты для всех

# --- Mini App (нужен публичный HTTPS-адрес, см. README)
# WEBAPP_URL=https://schedule.example.com      # адрес, по которому снаружи открывается этот сервер
# MINIAPP_LINK=https://t.me/ИМЯ_БОТА/schedule  # прямая ссылка из BotFather (/newapp), для кнопки в беседе
# WEBAPP_PORT=8080                             # порт, который слушает сервер (на хостинге — выданный порт)
# WEBAPP_AUTH_MAX_AGE=3600                    # срок действия initData, секунд
# WEBAPP_MEMBERS_ONLY=0                        # 1 — пускать только участников беседы CHAT_ID
# WEBAPP_DEV=0                                 # 1 — без проверки подписи Telegram (только для отладки в браузере)


# --- Передача расписания на отдельный сервер Mini App (необязательно)
# SCHEDULE_SYNC_URL=https://sa225-miniapp-production.up.railway.app/api/schedule-sync
# SCHEDULE_SYNC_SECRET=тот_же_случайный_секрет_что_в_Railway
